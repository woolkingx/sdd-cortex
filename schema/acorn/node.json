{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "acorn/node.json",
  "definitions": {
    "Node": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "type": {
          "type": "string"
        },
        "range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "loc": {
          "oneOf": [
            {
              "$ref": "#/definitions/SourceLocation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["start", "end", "type"]
    },
    "SourceLocation": {
      "type": "object",
      "properties": {
        "source": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "$ref": "#/definitions/Position"
        },
        "end": {
          "$ref": "#/definitions/Position"
        }
      },
      "required": ["start", "end"]
    },
    "Position": {
      "type": "object",
      "properties": {
        "line": {
          "type": "number",
          "description": "1-based"
        },
        "column": {
          "type": "number",
          "description": "0-based"
        }
      },
      "required": ["line", "column"]
    },
    "Identifier": {
      "allOf": [
        {
          "$ref": "#/definitions/Node"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "Identifier"
            },
            "name": {
              "type": "string"
            }
          },
          "required": ["name"]
        }
      ]
    },
    "Literal": {
      "allOf": [
        {
          "$ref": "#/definitions/Node"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "Literal"
            },
            "value": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                },
                {
                  "type": "number"
                },
                {
                  "type": "object"
                }
              ]
            },
            "raw": {
              "type": "string"
            },
            "regex": {
              "type": "object",
              "properties": {
                "pattern": {
                  "type": "string"
                },
                "flags": {
                  "type": "string"
                }
              },
              "required": ["pattern", "flags"]
            },
            "bigint": {
              "type": "string"
            }
          }
        }
      ]
    },
    "Program": {
      "allOf": [
        {
          "$ref": "#/definitions/Node"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "Program"
            },
            "body": {
              "type": "array",
              "items": {}
            },
            "sourceType": {
              "enum": ["script", "module"]
            }
          },
          "required": ["body", "sourceType"]
        }
      ]
    },
    "Super": {
      "allOf": [
        {
          "$ref": "#/definitions/Node"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "Super"
            }
          }
        }
      ]
    },
    "Comment": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["Line", "Block"]
        },
        "value": {
          "type": "string"
        },
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "loc": {
          "oneOf": [
            {
              "$ref": "#/definitions/SourceLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["type", "value", "start", "end"]
    }
  }
}
