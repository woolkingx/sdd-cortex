{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "analysis/metrics.json",
  "title": "AnalysisMetrics",
  "description": "Quantitative analysis metrics.",

  "definitions": {

    "FileComplexity": {
      "description": "Structural complexity metrics for a single file, computed from AST data.",
      "type": "object",
      "properties": {
        "file":           { "type": "string" },
        "functions":      { "type": "integer", "minimum": 0, "description": "Total function count" },
        "exports":        { "type": "integer", "minimum": 0, "description": "Export count (API surface)" },
        "internals":      { "type": "integer", "minimum": 0, "description": "Non-exported function count" },
        "ratio":          { "type": "number", "description": "internal:export ratio — high = hidden complexity" },
        "calls":          { "type": "integer", "minimum": 0, "description": "Distinct outgoing call count" },
        "classes":        { "type": "integer", "minimum": 0 },
        "fan_in":         { "type": "integer", "minimum": 0 },
        "fan_out":        { "type": "integer", "minimum": 0 },
        "depth":          { "type": "integer", "minimum": 0, "description": "Longest dependency path from this file to a leaf" },
        "lines":          { "type": "integer", "minimum": 0 }
      },
      "required": ["file", "functions", "exports", "internals", "ratio", "calls", "classes", "fan_in", "fan_out", "depth", "lines"],

      "x-docs": {
        "intent": "Per-file structural complexity. Replaces line-count-only large_files metric. Flags based on AST-derived structure, not LOC.",
        "category": "analysis"
      }
    },

    "AnalysisStats": {
      "description": "Summary statistics for the analysis run.",
      "type": "object",
      "properties": {
        "total_files":          { "type": "integer", "minimum": 0 },
        "total_edges":          { "type": "integer", "minimum": 0 },
        "confirmed_violations": { "type": "integer", "minimum": 0 },
        "false_positives":      { "type": "integer", "minimum": 0 },
        "orphan_nodes":         { "type": "integer", "minimum": 0 },
        "complex_files":          { "type": "integer", "minimum": 0 },
        "cycles":               { "type": "integer", "minimum": 0 },
        "max_fan_in":           { "type": "integer", "minimum": 0, "description": "Highest number of incoming edges on a single node" },
        "max_fan_out":          { "type": "integer", "minimum": 0, "description": "Highest number of outgoing edges from a single node" },
        "longest_path":                { "type": "integer", "minimum": 0, "description": "Length of longest dependency chain" },
        "duplicate_instantiations":    { "type": "integer", "minimum": 0, "description": "Number of factories instantiated in multiple files" },
        "total_symbols":         { "type": "integer", "minimum": 0, "description": "Number of symbol-level nodes (FUNCTION + CLASS + METHOD)" },
        "total_call_edges":      { "type": "integer", "minimum": 0, "description": "CALL + CALLBACK + CALL_INDIRECT edges" },
        "total_contains_edges":  { "type": "integer", "minimum": 0, "description": "CONTAINS + METHOD_OF edges" },
        "cross_file_calls":      { "type": "integer", "minimum": 0, "description": "CALL edges where from.file != to.file" },
        "boundary_violations":   { "type": "integer", "minimum": 0, "description": "Calls to unexported symbols across file boundary" }
      },
      "required": ["total_files", "total_edges", "confirmed_violations", "false_positives", "orphan_nodes", "complex_files", "cycles", "longest_path"],

      "x-docs": {
        "intent": "Quantitative summary. Enables CI exit code and trend tracking.",
        "category": "analysis"
      }
    }

  }
}
